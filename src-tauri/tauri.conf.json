{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpaceRecycle",
  "version": "0.1.0",
  "identifier": "com.spacerrecycle.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SpaceRecycle",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}