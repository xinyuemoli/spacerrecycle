# Build output: the DLL and its test host are produced by build.cmd and are not
# source. The icons are generated by tools/make_icons.py and kept in the tree so
# a build does not depend on Python.
bin/

# MSVC intermediates from an in-place compile.
*.obj
*.exp
*.lib
*.pdb

# The probe builds in place rather than into bin/.
probe/*.dll

# The probe's own log. It is a diagnostic artefact, not a fixture.
probe/probe.log