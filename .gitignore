node_modules/

# Frontend IS part of the app - it must be tracked, not ignored.
!dist/

src-tauri/target/
*.log

# Stray Windows cache dirs that can appear in the repo root when tests
# pass a literal %SystemDrive% through to the filesystem layer.
/%SystemDrive%/

# The render harnesses are dev-only but must be tracked: they are the only
# automated coverage the frontend has.
COMMIT_MSG.txt

# Output of the --probe-cancel diagnostic.
src-tauri/cancel_probe.txt

# Cloudflare Wrangler local state (deployment cache, local bindings).
.wrangler/

# --- browser profiles ---------------------------------------------------------------
# Chromium user-data directories. These are not clutter: a profile holds
# Cookies, Login Data (saved passwords), Web Data and History. The copies that
# appeared here were produced by the promo scripts driving a logged-in browser,
# so they carried live sessions for the accounts being posted from. DPAPI
# encrypts the secrets to the Windows account that wrote them, which is not a
# reason to publish the files.
user-data/
**/user-data/
*-user-data/
**/*-user-data/
**/Login Data
**/Login Data For Account
**/Secure Preferences
**/Cookies-journal

# --- local machine state ------------------------------------------------------------
# ACL backups and reports produced while diagnosing this machine's permissions.
# They name real paths and real security identifiers.
acl-recovery/

# Editor and agent scratch directories.
.commandcode/

# --- stray working files ------------------------------------------------------------
# Ad-hoc scripts and probe output that live in the repository root while
# debugging. Underscore-prefixed so they sort together and stand out.
/_*.ps1
/_*.txt
/_*.png
/_*.json

# --- material that must not be published --------------------------------------------
# Promotion drafts and the browser automation that posts them, for the platform
# that asked for them to be taken down. Both the files and their history were
# removed; these rules are so that a later `git add -A` cannot bring them back.
#
# The automation is a separate matter from the drafts. Scripts that log into a
# social platform and publish on the user's behalf are against that platform's
# terms, and a public repository is the wrong place to keep them whatever one
# thinks of the terms.
promo/xiaohongshu.md
promo/xiaohongshu_report.md
promo/publish-notes.md
promo_xiaohongshu.py
promo/store/shotgen/batch_promo.js
promo/store/shotgen/batch2_promo.js
promo/store/shotgen/login_check.js
promo/store/shotgen/open_visible.js
promo/store/shotgen/retry_post.js
promo/store/shotgen/search_debug.js
promo/store/shotgen/test_search.js
promo/store/shotgen/urgent_post.js
promo/store/shotgen/xiaohongshu_check.js
promo/store/shotgen/xiaohongshu_promotion.js

# Crash dumps pulled back from the VM for analysis. Hundreds of megabytes
# each, and they contain a full process memory image.
/_dumps/

# Test signing certificate, exported from the freshly built MSIX. Public key
# only, but it changes with every build, so it is not worth versioning.
driver/vm/win11/sr-signing.cer

# Python bytecode from the throwaway analysis scripts.
__pycache__/
*.pyc

# One-off analysis scripts, like _*.ps1: throwaway, not part of the product.
scripts/_*.py

# ---------------------------------------------------------------- not source

# Local agent instructions. Deliberately kept out of the repository: it is about
# how this machine is worked on, not about the product.
/AGENTS.md

# Promotion material: copy for Xiaohongshu / Zhihu / Weibo / V2EX / Reddit /
# Product Hunt, store listing screenshots, and the scripts that generate them.
# Not code, and the store shots contain the publishing account's UI.
/promo/

# Screenshots and text captured from the verification VM as evidence. Useful
# while working on a problem, not part of the product.
/driver/vm/evidence/
/shell-ext/vm/evidence/

# The VM definition is generated and carries absolute host paths (ISO location,
# VMware install directory, shared folder). The .vmx the VM actually runs from
# lives outside the repository.
/driver/vm/win11/*.vmx
/driver/vm/win11/*.vmxf
/driver/vm/win11/*.vmsd
/driver/vm/win11/*.vmsn
/driver/vm/win11/*.nvram
/driver/vm/win11/*.lck/
/driver/vm/win11/*.log

# Preview render of the overlay icons, used while designing them.
/shell-ext/icons/_preview.png

# Signing material and keys. Never commit these: a private key in a public
# repository is not recoverable by deleting the file.
*.pfx
*.p12
*.pem
*.key
*.kdbx
!**/test-fixtures/**/*.pem

# Browser profiles. Cookies, saved passwords, autofill, history and the key that
# decrypts them. Automated screenshot scripts create these; they are a live
# credential store while they exist.
**/user-data/
**/edgeprofile/
**/chrome-profile/
**/Cookies
**/Cookies-journal
**/Login Data
**/Login Data For Account
**/Web Data
**/Account Web Data
**/Local State
**/Secure Preferences
**/key4.db
**/logins.json
**/cookies.sqlite
**/places.sqlite/driver/vm/win11/*.vmdk
/driver/vm/win11/*.vmem
/driver/vm/win11/*.vmss
/driver/vm/win11/*.vmx.lck/
**/*.vmdk
**/*.vmem